# --- Raw SCF data (3.5 GB): re-pull with R/01_download.R + manual steps in kids_methods.qmd ---
/data_raw/*
# keep the download manifest (URLs + md5s) for provenance
!/data_raw/download_manifest.csv
# Rebuilt verification copies and execution logs are local artifacts.
/audit/reproduction/
/audit/**/reproduction/
/audit/logs/
/audit/**/logs/

# Replicate-weight copies used by the audit (2013/2016)
/audit/rw/

# Raw data formats anywhere, as a backstop
*.dta
*.zip
*.sas7bdat

# --- Derived / formatted data (rebuilt by the R pipeline) ---
*.rds
*.RData
*.rda

# Fed codebooks (re-downloadable, ~2.6 MB each)
/docs/codebk*.txt

# Private editorial drafts and local output snapshots
/attack_memo*.md
/backups/
/Codex Rewrite.md
/post_text.md
/post_for_google_docs.html

# --- R / Quarto / OS cruft ---
.Rhistory
.RData
.Rproj.user/
.Renviron
.env
.quarto/
__pycache__/
*_files/
.DS_Store

# Local Claude Code config
.claude/
